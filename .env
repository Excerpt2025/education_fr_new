# Copy this file to .env and fill in real values.
# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Dev/demo only - lets KCET/PGCET predictor pages bypass payment entirely via
# a "Skip Payment" button in the UI. Only takes effect if set to 'true' here
# on the server; a client can never turn this on by itself. Remove/set to
# false before deploying to production.
ALLOW_DEV_SKIP_PAYMENT=true

# ------------------------------------------------------------
# DATABASE (MongoDB Atlas or local MongoDB)
# ------------------------------------------------------------
# Local:      mongodb://127.0.0.1:27017/mapmycareer360
# Atlas:      mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mapmycareer360
MONGO_URI=mongodb+srv://mmc360development_db_user:BeEwtIZqwOJecj28@education-consultancy-p.hkvmaka.mongodb.net/

# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# ALLOWED FRONTEND ORIGINS (comma separated)
# Used for CORS - add localhost for dev and your live domain(s) for production
# ------------------------------------------------------------
CLIENT_ORIGINS=http://localhost:3000,https://mapmycareer360.com,https://www.mapmycareer360.com

# ------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay shown as example - swap for PhonePe/Stripe if needed)
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_TZRW2xP0ZY4x90

RAZORPAY_KEY_SECRET=XTp2Wv3h90QA77hZIUCWu83G


#For live razropay

# RAZORPAY_KEY_ID=rzp_live_SGrJz9V4DvJJlw

# RAZORPAY_KEY_SECRET=bPYzYXcGW2XtX1th4lyEEJx



# ------------------------------------------------------------
# DEFAULT ADMIN (auto-created on first server start if not present)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@mapmycareer360.com
ADMIN_PASSWORD=Admin@12345

# ------------------------------------------------------------
# SCALABILITY TUNING (safe defaults - raise as real traffic grows)
# ------------------------------------------------------------
# MongoDB connection pool - reused across all requests, not one-per-request
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2
# In-memory response cache TTL (ms) for public read-heavy endpoints
# (sliders, colleges, courses, subscription plans, page content)
CACHE_TTL_MS=60000
